{
  "compilerOptions": {
    "composite": true, "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "types": ["node", "vitest/globals"],
    "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "e2e/**/*.ts", "electron.vite.config.ts", "playwright.config.ts", "vitest.config.ts", "src/renderer/src/format.ts"]
}
