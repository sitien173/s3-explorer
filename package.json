{
  "name": "s3-media-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "A Linux desktop app for browsing, managing, and streaming S3 media.",
  "author": "S3 Media Explorer Maintainers <maintainers@example.invalid>",
  "homepage": "https://example.invalid/s3-media-explorer",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --linux AppImage deb",
    "e2e": "playwright test",
    "dev": "electron-vite dev",
    "seek:2gb": "jiti scripts/seek-2gb.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/lib-storage": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@smithy/shared-ini-file-loader": "4.7.2",
    "@tanstack/react-virtual": "3.14.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.18.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
